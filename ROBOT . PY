"""Robot de pronostics : analyse chaque jour les matchs de 9 compétitions.
Source : football-data.org (offre gratuite). Modèle : Poisson basé sur le classement.
"""
import datetime as dt
import math
import os
import sys
import time

import requests

TOKEN = os.environ.get("FOOTBALL_DATA_TOKEN")
if not TOKEN:
    sys.exit("FOOTBALL_DATA_TOKEN manquant (ajoute-le dans Settings > Secrets > Actions)")

BASE = "https://api.football-data.org/v4"
HEADERS = {"X-Auth-Token": TOKEN}
COMPS = {
    "CL": "Ligue des champions",
    "FL1": "Ligue 1",
    "BL1": "Bundesliga",
    "PD": "La Liga",
    "SA": "Série A",
    "PL": "Premier League",
    "ELC": "Championship",
    "PPL": "Liga Portugal",
    "BSA": "Brasileirão",
}


def get(path, params=None):
    """Appel API avec pause (limite gratuite : 10 requêtes/minute)."""
    for _ in range(3):
        r = requests.get(BASE + path, headers=HEADERS, params=params, timeout=30)
        if r.status_code == 429:
            time.sleep(65)
            continue
        time.sleep(6.5)
        if r.ok:
            return r.json()
        print(f"Erreur {r.status_code} sur {path}")
        return None
    return None


def team_stats(code):
    data = get(f"/competitions/{code}/standings")
    if not data:
        return {}, 1.3
    stats, gf_tot, pg_tot = {}, 0, 0
    for table in data.get("standings", []):
        if table.get("type") != "TOTAL":
            continue
        for row in table["table"]:
            stats[row["team"]["id"]] = (row["playedGames"], row["goalsFor"], row["goalsAgainst"])
            gf_tot += row["goalsFor"]
            pg_tot += row["playedGames"]
    avg = gf_tot / pg_tot if pg_tot else 1.3
    return stats, avg


def strengths(stats, avg, team_id, prior=5):
    pg, gf, ga = stats.get(team_id, (0, 0, 0))
    att = (gf + avg * prior) / (pg + prior) / avg
    dfn = (ga + avg * prior) / (pg + prior) / avg
    return att, dfn


def poisson(k, lam):
    return math.exp(-lam) * lam**k / math.factorial(k)


def predict(stats, avg, home_id, away_id):
    att_h, def_h = strengths(stats, avg, home_id)
    att_a, def_a = strengths(stats, avg, away_id)
    lam_h = avg * att_h * def_a * 1.12
    lam_a = avg * att_a * def_h * 0.92
    p1 = pn = p2 = over = btts = 0.0
    best, best_p = (0, 0), 0.0
    for i in range(9):
        for j in range(9):
            p = poisson(i, lam_h) * poisson(j, lam_a)
            if i > j:
                p1 += p
            elif i == j:
                pn += p
            else:
                p2 += p
            if i + j > 2:
                over += p
            if i > 0 and j > 0:
                btts += p
            if p > best_p:
                best, best_p = (i, j), p
    return lam_h, lam_a, p1, pn, p2, over, btts, best


def tendance(p1, pn, p2):
    if p1 >= 0.5:
        return "Victoire domicile"
    if p2 >= 0.5:
        return "Victoire extérieur"
    if p1 + pn >= p2 + pn and p1 + pn >= p1 + p2:
        return "Domicile ou nul (1N)"
    if p2 + pn >= p1 + p2:
        return "Extérieur ou nul (N2)"
    return "Pas de nul (12)"


def main():
    today = dt.datetime.now(dt.timezone.utc).date().isoformat()
    lines = [f"# Pronostics du {today}\n"]
    total = 0
    for code, name in COMPS.items():
        data = get(f"/competitions/{code}/matches", {"dateFrom": today, "dateTo": today})
        matches = (data or {}).get("matches", [])
        if not matches:
            continue
        stats, avg = team_stats(code)
        lines.append(f"\n## {name}\n")
        for m in matches:
            h, a = m["homeTeam"], m["awayTeam"]
            if not h.get("id") or not a.get("id"):
                continue
            lh, la, p1, pn, p2, over, btts, best = predict(stats, avg, h["id"], a["id"])
            heure = m["utcDate"][11:16] + " UTC"
            lines.append(
                f"- **{h['name']} - {a['name']}** ({heure})\n"
                f"  - 1: {p1:.0%} | N: {pn:.0%} | 2: {p2:.0%}\n"
                f"  - Buts attendus : {lh:.1f} - {la:.1f} | score probable : {best[0]}-{best[1]}\n"
                f"  - +2,5 buts : {over:.0%} | Les 2 marquent : {btts:.0%}\n"
                f"  - Tendance : {tendance(p1, pn, p2)}"
            )
            total += 1
    if total == 0:
        lines.append("\nAucun match aujourd'hui.")
    lines.append("\n\n_Estimations statistiques, aucune garantie de résultat._")
    with open("pronos.md", "w", encoding="utf-8") as f:
        f.write("\n".join(lines))
    print(f"{total} match(s) analysé(s)")


if __name__ == "__main__":
    main()
